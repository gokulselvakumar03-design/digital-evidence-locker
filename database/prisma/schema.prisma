// ==========================================
// Prisma Schema Definition
// Digital Evidence Locker & Legal Workflow Platform
// ==========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMERATIONS
// ==========================================

enum Role {
  ADMIN
  INVESTIGATOR
  LAWYER
  VIEWER
  LEGAL_COUNSEL
  AUDITOR
}

enum CaseStatus {
  OPEN
  UNDER_INVESTIGATION
  IN_REVIEW
  UNDER_REVIEW
  CLOSED
  ARCHIVED
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  URGENT
}

enum EvidenceType {
  DOCUMENT
  AUDIO
  VIDEO
  IMAGE
  FORENSIC_IMAGE
  OTHER
}

enum EvidenceStatus {
  PENDING
  UPLOADED
  VERIFIED
  UNDER_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum AnalysisType {
  OCR
  SPEECH_TO_TEXT
  IMAGE_ANALYSIS
  VIDEO_ANALYSIS
  DOCUMENT_SUMMARY
  SEMANTIC_SEARCH
  ENTITY_EXTRACTION
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE_CASE
  UPDATE_CASE
  DELETE_CASE
  UPLOAD_EVIDENCE
  UPDATE_EVIDENCE
  DELETE_EVIDENCE
  CREATE_COMMENT
  UPDATE_COMMENT
  DELETE_COMMENT
  ASSIGN_CASE
  CHANGE_CASE_STATUS
  VERIFY_EVIDENCE
  APPROVE_EVIDENCE
  REJECT_EVIDENCE
  AI_ANALYSIS_STARTED
  AI_ANALYSIS_COMPLETED
  AI_ANALYSIS_FAILED
}

// ==========================================
// MODELS
// ==========================================

model User {
  id           String    @id @default(uuid())
  name         String    @default("")
  email        String    @unique
  password     String    @default("")
  passwordHash String    @default("")
  firstName    String?
  lastName     String?
  role         Role      @default(INVESTIGATOR)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relationships
  createdCases     Case[]         @relation("CreatedCases")
  assignedCases    Case[]         @relation("AssignedCases")
  caseMemberships  CaseMember[]
  uploadedEvidence Evidence[]     @relation("UploadedEvidence")
  verifiedHashes   EvidenceHash[] @relation("VerifiedHashes")
  comments         Comment[]
  notifications    Notification[]
  auditLogs        AuditLog[]     @relation("PerformedAuditLogs")
  aiAnalyses       AIAnalysis[]   @relation("CreatedAIAnalyses")

  @@index([email])
  @@index([role])
  @@index([deletedAt])
}

model Case {
  id           String       @id @default(uuid())
  caseNumber   String       @unique
  title        String
  description  String?      @db.Text
  category     String       @default("GENERAL")
  status       CaseStatus   @default(OPEN)
  priority     CasePriority @default(MEDIUM)
  createdById  String
  assignedToId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  closedAt     DateTime?
  deletedAt    DateTime?

  // Relationships
  createdBy  User         @relation("CreatedCases", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo User?        @relation("AssignedCases", fields: [assignedToId], references: [id], onDelete: SetNull)
  members    CaseMember[]
  evidence   Evidence[]
  comments   Comment[]

  @@index([caseNumber])
  @@index([status])
  @@index([priority])
  @@index([createdById])
  @@index([assignedToId])
  @@index([category])
  @@index([deletedAt])
}

model CaseMember {
  id           String   @id @default(uuid())
  caseId       String
  userId       String
  assignedRole String   @default("MEMBER")
  assignedAt   DateTime @default(now())

  // Relationships
  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId])
  @@index([caseId])
  @@index([userId])
}

model Evidence {
  id               String         @id @default(uuid())
  evidenceNumber   String         @unique
  caseId           String
  uploadedById     String
  title            String
  description      String?        @db.Text
  fileName         String
  originalFileName String
  fileType         String
  mimeType         String
  fileSize         Int
  storageUrl       String
  thumbnailUrl     String?
  hash             String
  status           EvidenceStatus @default(PENDING)
  tags             String[]       @default([])
  remarks          String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  // Relationships
  case       Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedBy User          @relation("UploadedEvidence", fields: [uploadedById], references: [id], onDelete: Restrict)
  hashRecord EvidenceHash?
  comments   Comment[]
  analyses   AIAnalysis[]

  @@index([evidenceNumber])
  @@index([caseId])
  @@index([uploadedById])
  @@index([status])
  @@index([fileType])
  @@index([hash])
  @@index([deletedAt])
}

model EvidenceHash {
  id           String   @id @default(uuid())
  evidenceId   String   @unique
  sha256Hash   String
  calculatedAt DateTime @default(now())
  verifiedById String?

  // Relationships
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  verifiedBy User?    @relation("VerifiedHashes", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([evidenceId])
  @@index([sha256Hash])
}

model AuditLog {
  id            String      @id @default(uuid())
  action        AuditAction
  entityType    String
  entityId      String
  description   String      @default("") @db.Text
  performedById String
  ipAddress     String?
  userAgent     String?
  oldValue      Json?
  newValue      Json?
  createdAt     DateTime    @default(now())

  // Relationships
  performedBy User @relation("PerformedAuditLogs", fields: [performedById], references: [id], onDelete: Cascade)

  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([performedById])
  @@index([createdAt])
  @@index([entityType, entityId])
}

enum NotificationType {
  CASE_ASSIGNED
  CASE_UPDATED
  CASE_CLOSED
  EVIDENCE_UPLOADED
  EVIDENCE_APPROVED
  EVIDENCE_REJECTED
  NEW_COMMENT
  AI_ANALYSIS_COMPLETED
  AI_ANALYSIS_FAILED
  SYSTEM
}

model Notification {
  id         String           @id @default(uuid())
  title      String
  message    String           @db.Text
  type       NotificationType @default(SYSTEM)
  userId     String
  isRead     Boolean          @default(false)
  readAt     DateTime?
  entityType String?
  entityId   String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
}

model Comment {
  id              String    @id @default(uuid())
  content         String    @db.Text
  caseId          String?
  evidenceId      String?
  userId          String
  parentCommentId String?
  isEdited        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Relationships
  case          Case?     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  evidence      Evidence? @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentComment Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies       Comment[] @relation("CommentReplies")

  @@index([caseId])
  @@index([evidenceId])
  @@index([userId])
  @@index([parentCommentId])
  @@index([deletedAt])
}

model AIAnalysis {
  id             String         @id @default(uuid())
  evidenceId     String
  analysisType   AnalysisType
  status         AnalysisStatus @default(PENDING)
  requestId      String?
  result         Json?
  summary        String?        @db.Text
  confidence     Float?
  processingTime Float?
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relationships
  evidence  Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  createdBy User     @relation("CreatedAIAnalyses", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([evidenceId])
  @@index([status])
  @@index([analysisType])
  @@index([createdById])
}
