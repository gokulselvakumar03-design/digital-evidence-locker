// ==========================================
// Prisma Schema Definition
// Digital Evidence Locker & Legal Workflow Platform
// ==========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMERATIONS
// ==========================================

enum Role {
  ADMIN
  INVESTIGATOR
  LEGAL_COUNSEL
  AUDITOR
}

enum CaseStatus {
  OPEN
  UNDER_REVIEW
  CLOSED
  ARCHIVED
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EvidenceType {
  DOCUMENT
  AUDIO
  VIDEO
  IMAGE
  FORENSIC_IMAGE
  OTHER
}

enum EvidenceStatus {
  PENDING
  VERIFIED
  TAMPERED
  REJECTED
}

enum AIAnalysisType {
  TRANSCRIPTION
  OCR
  SUMMARY
  ENTITY_EXTRACTION
}

enum AIAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  EXPORT
  VERIFY
}

// ==========================================
// MODELS
// ==========================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role     @default(INVESTIGATOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  createdCases     Case[]         @relation("CreatedCases")
  caseMemberships  CaseMember[]
  uploadedEvidence Evidence[]     @relation("UploadedEvidence")
  verifiedHashes   EvidenceHash[] @relation("VerifiedHashes")
  comments         Comment[]
  notifications    Notification[]
  auditLogs        AuditLog[]

  @@index([email])
  @@index([role])
}

model Case {
  id          String       @id @default(uuid())
  caseNumber  String       @unique
  title       String
  description String?      @db.Text
  status      CaseStatus   @default(OPEN)
  priority    CasePriority @default(MEDIUM)
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relationships
  createdBy User         @relation("CreatedCases", fields: [createdById], references: [id], onDelete: Restrict)
  members   CaseMember[]
  evidence  Evidence[]
  comments  Comment[]

  @@index([caseNumber])
  @@index([status])
  @@index([priority])
  @@index([createdById])
}

model CaseMember {
  id           String   @id @default(uuid())
  caseId       String
  userId       String
  assignedRole String   @default("MEMBER")
  assignedAt   DateTime @default(now())

  // Relationships
  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId])
  @@index([caseId])
  @@index([userId])
}

model Evidence {
  id           String         @id @default(uuid())
  caseId       String
  uploadedById String
  title        String
  description  String?        @db.Text
  fileUrl      String
  fileSize     Int
  mimeType     String
  type         EvidenceType   @default(DOCUMENT)
  status       EvidenceStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Relationships
  case       Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedBy User         @relation("UploadedEvidence", fields: [uploadedById], references: [id], onDelete: Restrict)
  hash       EvidenceHash?
  comments   Comment[]
  analyses   AIAnalysis[]

  @@index([caseId])
  @@index([uploadedById])
  @@index([status])
  @@index([type])
}

model EvidenceHash {
  id           String   @id @default(uuid())
  evidenceId   String   @unique
  sha256Hash   String
  calculatedAt DateTime @default(now())
  verifiedById String?

  // Relationships
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  verifiedBy User?    @relation("VerifiedHashes", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([evidenceId])
  @@index([sha256Hash])
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  action     AuditAction
  entityName String
  entityId   String
  details    Json?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime    @default(now())

  // Relationships
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([timestamp])
  @@index([entityName, entityId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model Comment {
  id         String   @id @default(uuid())
  caseId     String
  evidenceId String?
  authorId   String
  content    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relationships
  case     Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  evidence Evidence? @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([evidenceId])
  @@index([authorId])
}

model AIAnalysis {
  id           String           @id @default(uuid())
  evidenceId   String
  type         AIAnalysisType
  status       AIAnalysisStatus @default(PENDING)
  result       Json?
  errorMessage String?          @db.Text
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Relationships
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([evidenceId])
  @@index([status])
  @@index([type])
}
